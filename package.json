{
  "name": "flowmcp-grading",
  "version": "2.7.0",
  "description": "FlowMCP Grading reference implementation (gradingSpec/3.0.0, scoringSystem/1.0.0, gradingSystem/1.0.0).",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage:src": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build:questions": "node scripts/build-questions.mjs",
    "build:test-catalog": "node scripts/build-test-catalog.mjs",
    "build:question-catalog-doc": "node scripts/build-question-catalog-doc.mjs",
    "build:all": "npm run build:questions && npm run build:test-catalog && npm run build:question-catalog-doc",
    "validate:output-schemas": "node scripts/validate-output-schemas.mjs",
    "lint:hygiene": "node scripts/lint-repo-hygiene.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlowMCP/flowmcp-grading.git"
  },
  "license": "MIT",
  "dependencies": {
    "flowmcp": "github:FlowMCP/flowmcp-core#8ad69cd2d8e42b239952128e7d4ca53bc2f4f109",
    "js-yaml": "^3.14.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.mjs"
    ],
    "moduleFileExtensions": [
      "mjs",
      "js"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ]
  }
}
